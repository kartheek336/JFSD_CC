<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stopwatch</title>
    <style>
        #stopwatch {
            font-size: 2em;
        }
        .hours, .minutes, .seconds,  .milliseconds {
            color: black;
        }
        .start-button {
            background-color: rgb(0, 128, 0);
            color: white;
        }
        .stop-button {
            background-color: yellow;
            color: black;
        }
        .reset-button {
            background-color: orange;
            color: white;
        }
        button {
            font-size: 1em;
            margin: 5px;
            padding: 10px;
            border: none;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div id="stopwatch">
        <span class="hours">00</span>:<span class="minutes">00</span>:<span class="seconds">00</span>:<span class="milliseconds">00</span>
    </div>
    <button class="start-button" onclick="start()">Start</button>
    <button class="stop-button" onclick="stop()">Stop</button>
    <button class="reset-button" onclick="reset()">Reset</button>
    <script>
        let startTime, updatedTime, difference;
        let interval, running = 0;
        let hours, minutes, seconds, milliseconds;
        
        function start() {
            if (!running) {
                startTime = new Date().getTime();
                interval = setInterval(update, 10);
                running = 1;
            }
        }

        function stop() {
            if (running) {
                clearInterval(interval);
                running = 0;
            }
        }

        function reset() {
            clearInterval(interval);
            running = 0;
            document.querySelector(".hours").innerHTML = "00";
            document.querySelector(".minutes").innerHTML = "00";
            document.querySelector(".seconds").innerHTML = "00";
            document.querySelector(".milliseconds").innerHTML = "00";
        }

        function update() {
            updatedTime = new Date().getTime();
            difference = updatedTime - startTime;

            hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
            seconds = Math.floor((difference % (1000 * 60)) / 1000);
            milliseconds = Math.floor((difference % 1000) / 10);

            hours = (hours < 10) ? "0" + hours : hours;
            minutes = (minutes < 10) ? "0" + minutes : minutes;
            seconds = (seconds < 10) ? "0" + seconds : seconds;
            milliseconds = (milliseconds < 10) ? "0" + milliseconds : milliseconds;

            document.querySelector(".hours").innerHTML = hours;
            document.querySelector(".minutes").innerHTML = minutes;
            document.querySelector(".seconds").innerHTML = seconds;
            document.querySelector(".milliseconds").innerHTML = milliseconds;
        }
    </script>
</body>
</html>
